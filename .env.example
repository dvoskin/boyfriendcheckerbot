# ---- required ----
BOT_TOKEN=
# Contact email sent as User-Agent to SEC / archive.org. They ask for it and
# will throttle or block anonymous clients. Use a real mailbox you monitor.
CONTACT_EMAIL=danny@goalsplasticsurgery.com

# ---- optional: unlocks more sources, bot runs without them ----
# Report synthesis. Without it you get raw structured findings.
ANTHROPIC_API_KEY=

# Search API. Bing Search API was decommissioned 2025-08-11, so it is
# Brave or SerpAPI. Brave has a free tier; either one works.
# Brave also powers the sex-offender registry check.
BRAVE_API_KEY=
# SerpAPI additionally powers reverse image search (catfish detection).
SERPAPI_KEY=

# Twilio Lookup — phone number → registered name (CNAM), line type, carrier.
# The legal answer to GetContact. Both required for phone lookup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Enformion / EnformionGO (Endato) — the deep-background aggregator.
# One name → relatives, spouse, marriage/divorce, addresses, phones, emails,
# liens/judgments. ~$0.35 per match. Get creds at go.enformion.com. Both required.
ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=

# FEC political-donations API. Works without a key (DEMO_KEY, rate-limited);
# a free key from api.data.gov removes the cap.
FEC_API_KEY=

# (Business registrations now use the free Brave-powered directory search —
# no OpenCorporates key needed; their API is £2,250/yr.)

# HaveIBeenPwned ($3.95/mo, haveibeenpwned.com/API/Key) — email → data breaches,
# including dating/adult-site accounts he never mentioned.
HIBP_API_KEY=

# Bright Data (brightdata.com) — reads his PUBLIC Instagram/TikTok profile
# (bio, follower counts) legally via Web Unlocker. Zone name defaults to
# web_unlocker1; change if your zone is named differently.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker1

# UniCourt (unicourt.com) — state & federal court records (criminal, civil,
# family/divorce). OAuth2 client credentials.
UNICOURT_CLIENT_ID=
UNICOURT_CLIENT_SECRET=

# How often the watch loop re-checks each watched person (minutes). Default 360 (6h).
WATCH_INTERVAL_MIN=360

# Daily spend cap (USD) across paid sources (Enformion/Bright Data/Twilio/SerpAPI).
# Once hit, paid sources pause till tomorrow; free sources keep working. Default 50.
DAILY_SPEND_CAP_USD=50

# GitHub: 60 req/hr anonymous, 5000 req/hr with any classic token (no scopes needed).
GITHUB_TOKEN=

# CourtListener: free tier is 5/min, 50/hr, 125/DAY total. Enough for testing only.
# For production use the quarterly bulk snapshot, not this token.
COURTLISTENER_TOKEN=

# ---- ops ----
# Comma-separated Telegram user IDs allowed to use the bot while in private beta.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=
DATA_DIR=./data
